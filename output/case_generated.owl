  <rdf:Description rdf:about="https://ontology.caseontology.org/case/case#person:D._Pandana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.unifiedcyberontology.org/uco/identity/Person"/>
    <core:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Known associate of Jessie Pinkman, interrogated by police. Admitted having access to the drug lab's WiFi network. Denies any involvement in the raid.</core:description>
    <core:hasFacet rdf:resource="https://ontology.caseontology.org/case/case#simplenamefacet:D._Pandana"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.caseontology.org/case/case#person:Jessie_Pinkman">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.unifiedcyberontology.org/uco/identity/Person"/>
    <core:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Owner of the illegal drug lab raided on 2018-05-17. Not found at the scene. Per interrogated associates, had the IoT security systems installed fearing attacks from a rival gang, and kept the iSmartAlarm engaged in "Home" mode whenever present at the drug lab. These are claims reported by associates during interrogation, not independently verified facts.</core:description>
    <core:hasFacet rdf:resource="https://ontology.caseontology.org/case/case#simplenamefacet:Jessie_Pinkman"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.caseontology.org/case/case#person:S._Varga">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://ontology.unifiedcyberontology.org/uco/identity/Person"/>
    <core:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Known associate of Jessie Pinkman, interrogated by police. Admitted having access to the drug lab's WiFi network. Denies any involvement in the raid.</core:description>
    <core:hasFacet rdf:resource="https://ontology.caseontology.org/case/case#simplenamefacet:S._Varga"/>
  </rdf:Description>
